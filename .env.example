# Copy to .env.local for the fully connected app. Leave secrets out of git.
# The template workshop needs none of these: npm run dev:design-lab
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_PLACES_API_KEY=
OPENAI_API_KEY=
RESEND_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
INTERNAL_API_KEY=
ADMIN_API_KEY=
OUTBOUND_API_KEY=
ADMIN_EMAILS=brian@autolocal.ai
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Optional provider automation credential, sent only to immutable .vercel.app verification URLs.
VERCEL_AUTOMATION_BYPASS_SECRET=
# Optional BLE integration; keep disabled during recovery.
BLE_DISCORD_WEBHOOK_URL=

# Runtime: Node.js 24 LTS (.nvmrc). Never use live secrets for local tests.
# All side effects stay disabled until staging verification and launch approval.
AUTOLOCAL_ENABLE_BILLING=false
AUTOLOCAL_ENABLE_PUBLISHING=false
AUTOLOCAL_ENABLE_DOMAIN_PURCHASES=false
AUTOLOCAL_ENABLE_EMAIL=false
AUTOLOCAL_SCHEDULER_VERIFIED=false
AUTOLOCAL_SITES_DOMAIN=autolocal.ai
# Set for isolated nonproduction publishing; use a separate owned sites domain.
# Leave empty for production. Generated staging sites are excluded from indexing.
AUTOLOCAL_PUBLISHING_NAMESPACE=

# Stripe prices are verified with Stripe; prices are not accepted from browsers.
STRIPE_HOSTING_PRICE_ID=
STRIPE_MANAGED_PRICE_ID=

# Verified sender and registrant data, configured by the account owner.
EMAIL_FROM=
DOMAIN_REGISTRANT_JSON=

# Optional Google connections. Never put encryption keys or tokens in NEXT_PUBLIC variables.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
AUTOLOCAL_ENABLE_GOOGLE_CONNECTIONS=false
GOOGLE_BUSINESS_PROFILE_API_APPROVED=false
AUTOLOCAL_ENABLE_GBP_WRITES=false

# Shared anonymous lookup/contact budgets. Required for production endpoints.
# Generate a random secret >=32 bytes. No raw IPs are stored.
AUTOLOCAL_RATE_LIMIT_KEY=
# Vercel automatically sets VERCEL=1; on other hosts enable only after the proxy
# overwrites the client header (Railway: X-Real-IP; others: X-Forwarded-For)
# and blocks direct access to the origin. Verify with the protected proxy probe.
AUTOLOCAL_TRUST_PROXY_IP_HEADERS=false
AUTOLOCAL_EDGE_RATE_LIMIT_VERIFIED=false

# Optional read-only daily Google visibility refresh.
AUTOLOCAL_ENABLE_VISIBILITY_WORKER=false
